# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Chave secreta (Project Settings > API > service_role). NUNCA expor ao
# cliente - usada só nas rotas de servidor (cron de no-show/lembretes e
# sincronizacao do Google Calendar).
SUPABASE_SERVICE_ROLE_KEY=

# Cron jobs (api/cron/*) - qualquer string secreta, enviada como
# "Authorization: Bearer <CRON_SECRET>"
CRON_SECRET=

# Google Calendar OAuth (preencher depois - console.cloud.google.com)
# Redirect URI precisa estar cadastrada exatamente igual no Google Cloud Console.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://SEU-DOMINIO.vercel.app/api/google/callback

# WhatsApp Business API (Meta ou Twilio) - preencher depois
WHATSAPP_API_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_PROVIDER=meta

# Mercado Pago (Checkout Pro) - Access Token de producao, obtido em
# https://www.mercadopago.com.br/developers -> Suas integracoes -> credenciais.
# Sem essa variavel, "Pagar agora (antecipado)" fica indisponivel e o
# cliente so pode pagar no local.
MERCADOPAGO_ACCESS_TOKEN=

# App
NEXT_PUBLIC_SITE_URL=http://localhost:3000
